---
import { Image } from 'astro:assets';
import logo from '../assets/logo.jpg';
import { CONTACT_URL, NEW_TAB, SOCIAL } from '../data/links';

// PLACEHOLDER: estos links y datos legales son los de la landing actual.
// El contenido final (licencia, PDFs, links) lo provee el dueño del sitio.
const docs = [
	{ label: 'Quienes somos', href: '/docs/quienes-somos.pdf' },
	{ label: 'Licencia', href: '/docs/licencia_sam.pdf' },
	{ label: 'Local virtual', href: '/docs/local_virtual.pdf' },
];

const consumer = [
	{ label: 'Defensa del Consumidor', href: 'https://autogestion.produccion.gob.ar/consumidores' },
	{
		label: 'Denuncia contra una agencia',
		href: 'https://www.argentina.gob.ar/servicio/iniciar-un-reclamo-ante-defensa-del-consumidor',
	},
];

const socialLink =
	'grid size-10 place-items-center rounded-full text-white inset-ring inset-ring-white/25 transition-colors duration-300 ease-salida hover:bg-white hover:text-azul-tinta';
const groupTitle = 'mb-[0.9rem] text-[1rem] font-[650] tracking-[-0.01em] text-white';
const footerLink = 'no-underline hover:text-durazno hover:underline';
---

<footer class="bg-azul-tinta pt-[clamp(3rem,7vw,4.5rem)] pb-8 text-small text-white/82">
	<div class="wrap grid grid-cols-2 gap-10 min-[721px]:grid-cols-[1.4fr_1fr_1fr]">
		<div class="col-span-full flex items-center justify-between min-[721px]:col-span-1 min-[721px]:block">
			<Image src={logo} alt="Sumate al Mundo (SAM)" width={64} height={56} class="h-auto w-16 rounded-xl bg-white p-1" />
			<div class="flex gap-2 min-[721px]:mt-6">
				<a href={SOCIAL.facebook} class={socialLink} aria-label="Facebook (se abre en una pestaña nueva)" {...NEW_TAB}>
					<svg class="w-[1.1rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
				</a>
				<a href={SOCIAL.instagram} class={socialLink} aria-label="Instagram (se abre en una pestaña nueva)" {...NEW_TAB}>
					<svg class="w-[1.1rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><path d="M17.5 6.5h.01"></path></svg>
				</a>
				<a href={CONTACT_URL} class={socialLink} aria-label="Contacto por email">
					<svg class="w-[1.1rem]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="4" width="20" height="16" rx="2"></rect><path d="m22 7-10 6L2 7"></path></svg>
				</a>
			</div>
		</div>

		<nav aria-label="Documentación">
			<h2 class={groupTitle}>La agencia</h2>
			<ul class="grid gap-2">{docs.map((l) => <li><a href={l.href} class={footerLink} {...NEW_TAB}>{l.label}</a></li>)}</ul>
		</nav>

		<nav aria-label="Consumidores">
			<h2 class={groupTitle}>Consumidores</h2>
			<ul class="grid gap-2">{consumer.map((l) => <li><a href={l.href} class={footerLink} {...NEW_TAB}>{l.label}</a></li>)}</ul>
		</nav>
	</div>

	<div class="wrap mt-12 grid gap-1 border-t border-white/14 pt-6 text-[0.8125rem] text-white/66">
		<p>SUMATE AL MUNDO – SAM · Legajo 18281 E.V.T. (Empresa de Viajes y Turismo) · Ministerio de Turismo y Deportes</p>
		<p>TABORDA, RAFAEL ALEJANDRO · CUIT 23-18174340-9</p>
	</div>
</footer>
