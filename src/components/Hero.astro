---
import { Picture } from 'astro:assets';
import hero from '../assets/hero.jpg';
import { MAIN_SITE_URL, TAGLINES } from '../data/links';
import Button from './Button.astro';

interface Props {
	/** Muestra un indicador para bajar (solo cuando hay secciones debajo) */
	scrollTo?: string;
}

const { scrollTo } = Astro.props;
const [first, ...rest] = TAGLINES;

// Todas las frases ocupan la misma celda de grid (así el layout no se mueve).
// La activa se marca con data-active; la que sale, con data-leaving.
const phrase =
	'col-start-1 row-start-1 translate-y-[0.35em] opacity-0 blur-[8px] transition-[opacity,translate,filter] duration-700 ease-salida motion-reduce:transition-none data-active:translate-y-0 data-active:opacity-100 data-active:blur-none data-leaving:-translate-y-[0.35em]';
---

<section class="relative isolate grid min-h-svh items-end overflow-hidden bg-azul-tinta text-white">
	<Picture
		src={hero}
		alt=""
		formats={['avif', 'webp']}
		widths={[640, 960, 1280, 1920, 2560]}
		sizes="100vw"
		class="absolute inset-0 -z-2 size-full object-cover object-[40%_50%]"
		loading="eager"
		fetchpriority="high"
	/>
	<div class="velo-hero absolute inset-0 -z-1" aria-hidden="true"></div>

	<div class="wrap pt-32 pb-[clamp(3.5rem,9vh,6rem)]">
		<h1 class="max-w-[14ch] text-display">
			<span class="block text-durazno">Viajá</span>
			<span class="grid" data-rotator>
				<span class={phrase} data-phrase data-active>{first}</span>
				{/* El resto de las frases va en un <template>: no forma parte del texto del h1
				    (ni para buscadores ni para lectores de pantalla) y el script las suma. */}
				<template>{rest.map((t) => <span class={phrase} data-phrase aria-hidden="true">{t}</span>)}</template>
			</span>
		</h1>

		<div class="mt-[clamp(2rem,5vh,3.25rem)] flex flex-wrap items-center gap-x-7 gap-y-4">
			<p class="font-display text-question text-white/92">¿Querés sumarte al mundo?</p>
			<Button href={MAIN_SITE_URL} arrow>Quiero sumarme</Button>
		</div>
	</div>

	{
		scrollTo && (
			<a
				class="absolute right-gutter bottom-[clamp(3.5rem,9vh,6rem)] hidden size-12 place-items-center rounded-full inset-ring-[1.5px] inset-ring-white/50 transition-colors duration-300 ease-salida hover:bg-white/15 min-[641px]:grid"
				href={scrollTo}
				aria-label="Ver más"
			>
				<svg class="w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M12 5v14M6 13l6 6 6-6" />
				</svg>
			</a>
		)
	}
</section>

<script>
	const rotator = document.querySelector<HTMLElement>('[data-rotator]');
	const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

	if (rotator && !reduce) {
		const template = rotator.querySelector('template');
		if (template) rotator.append(template.content.cloneNode(true));
		const phrases = Array.from(rotator.querySelectorAll<HTMLElement>('[data-phrase]'));
		let i = 0;
		setInterval(() => {
			phrases[i].removeAttribute('data-active');
			phrases[i].setAttribute('data-leaving', '');
			const prev = phrases[i];
			setTimeout(() => prev.removeAttribute('data-leaving'), 700);
			i = (i + 1) % phrases.length;
			phrases[i].setAttribute('data-active', '');
		}, 2800);
	}
</script>
