---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const {
	title = 'Sumate al Mundo · TUR',
	description = 'Sumate al Mundo (SAM), Empresa de Viajes y Turismo. Viajá como turista o como viajera/o, sumergite en otra cultura y sumate a cambiar el mundo.',
} = Astro.props;
---

<!doctype html>
<html lang="es-AR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#1f2257" />
		<title>{title}</title>
	</head>
	<body>
		<slot />
	</body>
</html>
