---
// Landing: hero + secciones tomadas de sumatealmundo.com.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import Button from '../components/Button.astro';
import { CONTACT_URL, MAIN_SITE_URL } from '../data/links';

const ways: { title: string; text: string; badge?: string }[] = [
	{
		badge: 'Nuevo',
		title: 'Viajes exóticos, especiales e históricos',
		text: 'Viajá a lugares que siempre soñaste conocer o volvé a esos rincones que te invitan a regresar.',
	},
	{ title: 'Viajes y cursos de inmersión', text: 'Sumergite en una cultura y un idioma diferente.' },
	{
		title: 'Inmersión académica',
		text: 'Profundizá tu idioma, tu profesión y tu oficio desde la mirada de otra cultura.',
	},
	{ title: 'High School', text: 'Preparate para un mundo internacional.' },
	{ title: 'Prácticas profesionales', text: 'Poné en juego tus actividades y habilidades en el lugar de destino.' },
];
---

<Layout>
	<Header />
	<main>
		<Hero scrollTo="#formas" />

		<section id="formas" class="scroll-mt-4 py-section">
			<div class="wrap grid items-start gap-[clamp(2.5rem,6vw,6rem)] min-[861px]:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]">
				<div class="min-[861px]:sticky min-[861px]:top-10">
					<h2 class="text-headline">Más formas de viajar, la misma esencia.</h2>
					<p class="mt-6 max-w-[38ch] text-body-lg text-azul-tinta-suave">
						Experiencias interculturales para vivir otro lugar desde adentro: descubriendo
						destinos únicos, estudiando, sumergiéndote en otro idioma o poniendo en práctica tu profesión.
					</p>
				</div>

				<ul class="border-t border-linea">
					{
						ways.map((w) => (
							<li class="group grid items-baseline gap-x-8 gap-y-2 border-b border-linea py-item min-[561px]:grid-cols-2 [&>*]:transition-[translate,color] [&>*]:duration-500 [&>*]:ease-salida hover:[&>*]:translate-x-3">
								{w.badge && (
									<span class="col-span-full mb-2 justify-self-start rounded-full bg-naranja-brujula-profundo px-[0.8em] py-[0.3em] font-display text-label text-white uppercase shadow-etiqueta">
										{w.badge}
									</span>
								)}
								<h3
									class:list={[
										'text-title group-hover:text-naranja-brujula-profundo',
										w.badge && 'text-naranja-brujula-profundo',
									]}
								>
									{w.title}
								</h3>
								<p class="text-azul-tinta-suave">{w.text}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="bg-papel-profundo py-[clamp(4.5rem,11vw,8rem)]" aria-labelledby="quote-title">
			<div class="wrap">
				<h2 id="quote-title" class="font-sans text-[1rem] font-semibold tracking-normal text-naranja-brujula-oscuro">
					Vos cambiás el mundo
				</h2>
				<figure class="mt-6">
					<blockquote>
						<p class="max-w-[22ch] font-display text-quote text-balance before:text-naranja-brujula before:content-['“'] after:text-naranja-brujula after:content-['”']">
							Nunca dudes que un pequeño grupo de personas comprometidas puede cambiar el mundo. De hecho, es
							lo único que lo ha logrado.
						</p>
					</blockquote>
					<figcaption class="mt-7 text-azul-tinta-suave">Margaret Mead</figcaption>
				</figure>
			</div>
		</section>

		<section class="py-[clamp(4rem,9vw,6.5rem)]">
			<div class="wrap flex flex-wrap items-center justify-between gap-8">
				<h2 class="text-cierre">Sumate con nosotros</h2>
				<div class="flex flex-wrap gap-3">
					<Button href={MAIN_SITE_URL} arrow>Quiero sumarme</Button>
					<Button variant="outline" href={CONTACT_URL}>Contactanos</Button>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>
