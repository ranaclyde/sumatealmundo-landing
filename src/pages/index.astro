---
// Landing: hero + secciones tomadas de sumatealmundo.com.
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Footer from '../components/Footer.astro';
import { CONTACT_URL, MAIN_SITE_URL } from '../data/links';

const ways: { title: string; text: string; badge?: string }[] = [
	{
		badge: 'Nuevo',
		title: 'Viajes exóticos, especiales e históricos',
		text: 'Viajá a lugares que siempre soñaste conocer o volvé a esos rincones que te invitan a regresar.',
	},
	{ title: 'Viajes y cursos de inmersión', text: 'Sumergite en una cultura y un idioma diferente.' },
	{
		title: 'Inmersión académica',
		text: 'Profundizá tu idioma, tu profesión y tu oficio desde la mirada de otra cultura.',
	},
	{ title: 'High School', text: 'Preparate para un mundo internacional.' },
	{ title: 'Prácticas profesionales', text: 'Poné en juego tus actividades y habilidades en el lugar de destino.' },
];
---

<Layout>
	<Header />
	<main>
		<Hero scrollTo="#formas" />

		<section id="formas" class="ways">
			<div class="wrap ways-grid">
				<div class="ways-intro">
					<h2>Más formas de viajar, la misma esencia.</h2>
					<p>
						Experiencias interculturales para vivir otro lugar desde adentro: descubriendo
						destinos únicos, estudiando, sumergiéndote en otro idioma o poniendo en práctica tu profesión.
					</p>
				</div>

				<ul class="ways-list">
					{
						ways.map((w) => (
							<li class:list={{ featured: w.badge }}>
								{w.badge && <span class="badge">{w.badge}</span>}
								<h3>{w.title}</h3>
								<p>{w.text}</p>
							</li>
						))
					}
				</ul>
			</div>
		</section>

		<section class="quote" aria-labelledby="quote-title">
			<div class="wrap">
				<h2 id="quote-title" class="quote-title">Vos cambiás el mundo</h2>
				<figure>
					<blockquote>
						<p>
							Nunca dudes que un pequeño grupo de personas comprometidas puede cambiar el mundo. De hecho, es
							lo único que lo ha logrado.
						</p>
					</blockquote>
					<figcaption>Margaret Mead</figcaption>
				</figure>
			</div>
		</section>

		<section class="join">
			<div class="wrap join-inner">
				<h2>Sumate con nosotros</h2>
				<div class="join-actions">
					<a class="btn btn-primary" href={MAIN_SITE_URL}>
						Quiero sumarme
						<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
					</a>
					<a class="btn btn-outline" href={CONTACT_URL}>Contactanos</a>
				</div>
			</div>
		</section>
	</main>
	<Footer />
</Layout>

<style>
	section {
		scroll-margin-top: 1rem;
	}

	/* ——— Formas de viajar ——— */
	.ways {
		padding-block: clamp(4.5rem, 11vw, 8.5rem);
	}

	.ways-grid {
		display: grid;
		grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: start;
	}

	.ways-intro {
		position: sticky;
		top: 2.5rem;
	}

	.ways-intro h2 {
		font-size: clamp(2.25rem, 4.6vw, 3.75rem);
		font-weight: 750;
	}

	.ways-intro p {
		margin-top: 1.5rem;
		max-width: 38ch;
		color: var(--ink-soft);
		font-size: 1.125rem;
	}

	.ways-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--line);
	}

	.ways-list li {
		display: grid;
		grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
		gap: 0.5rem 2rem;
		align-items: baseline;
		padding-block: clamp(1.5rem, 3vw, 2.25rem);
		border-bottom: 1px solid var(--line);
	}

	.ways-list li > * {
		transition: transform 0.5s var(--ease-out), color 0.4s var(--ease-out);
	}

	.ways-list h3 {
		font-size: clamp(1.5rem, 2.6vw, 2.125rem);
		font-weight: 650;
	}

	.ways-list p {
		color: var(--ink-soft);
	}

	.badge {
		grid-column: 1 / -1;
		justify-self: start;
		margin-bottom: 0.5rem;
		padding: 0.3em 0.8em;
		border-radius: 999px;
		background: var(--flame-deep);
		color: #fff;
		font-family: var(--font-display);
		font-size: 0.8125rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		line-height: 1.4;
		box-shadow: 0 6px 16px -8px color-mix(in oklab, var(--flame-deep) 80%, transparent);
	}

	.ways-list .featured h3 {
		color: var(--flame-deep);
	}

	@media (hover: hover) {
		.ways-list li:hover > * {
			transform: translateX(0.75rem);
		}

		.ways-list li:hover h3 {
			color: var(--flame-deep);
		}
	}

	/* ——— Cita ——— */
	.quote {
		background: var(--paper-deep);
		padding-block: clamp(4.5rem, 11vw, 8rem);
	}

	.quote-title {
		font-family: var(--font-body);
		font-size: 1rem;
		font-weight: 600;
		letter-spacing: 0;
		color: var(--flame-deep);
	}

	figure {
		margin: 1.5rem 0 0;
	}

	blockquote {
		margin: 0;
	}

	blockquote p {
		font-family: var(--font-display);
		font-size: clamp(1.875rem, 4.6vw, 3.625rem);
		font-weight: 600;
		line-height: 1.1;
		letter-spacing: -0.025em;
		max-width: 22ch;
		text-wrap: balance;
	}

	blockquote p::before {
		content: '“';
		color: var(--flame);
	}

	blockquote p::after {
		content: '”';
		color: var(--flame);
	}

	figcaption {
		margin-top: 1.75rem;
		color: var(--ink-soft);
	}

	/* ——— Sumate ——— */
	.join {
		padding-block: clamp(4rem, 9vw, 6.5rem);
	}

	.join-inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 2rem;
	}

	.join h2 {
		font-size: clamp(2.25rem, 5vw, 4rem);
		font-weight: 750;
	}

	.join-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
	}

	.btn-outline {
		color: var(--ink);
		box-shadow: inset 0 0 0 1.5px var(--ink);
	}

	.btn-outline:hover {
		background: var(--ink);
		color: #fff;
	}

	@media (max-width: 860px) {
		.ways-grid {
			grid-template-columns: 1fr;
		}

		.ways-intro {
			position: static;
		}
	}

	@media (max-width: 560px) {
		.ways-list li {
			grid-template-columns: 1fr;
		}
	}
</style>
